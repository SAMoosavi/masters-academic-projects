@article{gongPCASCryptanalysisImprovement2023,
  title = {{{PCAS}}: {{Cryptanalysis}} and Improvement of Pairing-Free Certificateless Aggregate Signature Scheme with Conditional Privacy-Preserving for {{VANETs}}},
  shorttitle = {{{PCAS}}},
  author = {Gong, Ziyan and Gao, Tianhan and Guo, Nan},
  date = {2023-05-01},
  journaltitle = {Ad Hoc Networks},
  shortjournal = {Ad Hoc Netw.},
  volume = {144},
  pages = {103134},
  issn = {1570-8705},
  doi = {10.1016/j.adhoc.2023.103134},
  url = {https://www.sciencedirect.com/science/article/pii/S1570870523000549},
  urldate = {2026-07-16},
  abstract = {Certificateless aggregate signature (CLAS) is an effective approach for the multiple authentications in multi-users and multi-information environments like the vehicular ad hoc networks (VANETs), which can address the certificate management issue in the traditional public key cryptography (PKC) and solve the key escrow problem in identity-based cryptography (IBC). In recent years, a new CLAS mechanism (LICLAS) is presented for the authentication of sensors in healthcare wireless medical sensor networks (HWMSNs). In this paper, we make an analysis and prove that LICLAS is not able to against forgery attacks. Thus, we present an improved CLAS scheme (PCAS) for vehicle authentication in VANETs, which satisfies the privacy and security requirements. PCAS constructs the signature algorithm based on Elliptic Curve Cryptography (ECC) to avoid bilinear pairing and Map-to-Hash function operations. In order to further improve security and efficiency of PCAS, the vehicle key generation and signature algorithm is revised. The pseudonym mechanism is also adopted to achieve conditional privacy preservation. Besides, PCAS allows to execute a batch verification of messages, where RSUs may verify the aggregated signatures from vehicles to reduce time overhead. Under the assumption that the elliptic curve discrete logarithm problem (ECDLP) is hard, PCAS is proved to be existentially unforgeable against adaptive chosen message attacks in the random oracle model. Through the performance analysis, under the same time complexity, PCAS is shown to more effective. Compared with LICLAS, for a single message and 2000 messages, the transmission overhead of PCAS is reduced by 25\% and 25\% respectively, and the computation overhead is reduced by 16.56\% and 25.34\% respectively.},
  keywords = {Batch verification,Certificateless aggregate signature,Conditional privacy preservation,Elliptic curve cryptography,Vehicular ad hoc networks (VANETs)},
  file = {/home/sam/snap/zotero-snap/common/Zotero/storage/WA4BDPMW/Gong et al. - 2023 - PCAS Cryptanalysis and improvement of pairing-free certificateless aggregate signature scheme with.pdf;/home/sam/snap/zotero-snap/common/Zotero/storage/6VFA5DUX/S1570870523000549.html}
}

@article{hanECLASEfficientPairingFree2022,
  title = {{{eCLAS}}: {{An Efficient Pairing-Free Certificateless Aggregate Signature}} for {{Secure VANET Communication}}},
  shorttitle = {{{eCLAS}}},
  author = {Han, Yibo and Song, Wei and Zhou, Zhangbing and Wang, Hao and Yuan, Bo},
  date = {2022-03},
  journaltitle = {IEEE Systems Journal},
  shortjournal = {IEEE Syst. J.},
  volume = {16},
  number = {1},
  pages = {1637--1648},
  issn = {1937-9234},
  doi = {10.1109/JSYST.2021.3116029},
  url = {https://ieeexplore.ieee.org/document/9580742},
  urldate = {2026-07-16},
  abstract = {Vehicular ad hoc networks (VANETs) have become an important part of the intelligent transportation system that aims to promote communication among vehicles to ensure vehicular safety and improve the driving experience. In VANETs, signed messages need to be authenticated by roadside units in a very short time. Certificateless aggregate signature (CLAS) scheme has been considered as one of the promising solutions to solve the problem of limited network bandwidth and computing power in VANETs environment. In this article, we propose an efficient pairing-free CLAS, named eCLAS, which is suitable for communication between vehicle to infrastructure. The aggregated signature allows individual signature on different messages from different vehicles to be aggregated into one short signature. In the random oracle model, the security of the scheme is proved by the adaptive selection message attack and the difficulty of computation of discrete logarithm problem on the elliptic curve. Additionally, the security analysis shows that the proposed scheme can meet security requirements in VANETs. Compared with existing schemes, the result demonstrates that our scheme has obvious advantages in signature verification, thereby granting it better applicability.},
  keywords = {Aggregate signature,Aggregates,authentication,Authentication,conditional privacy,Costs,elliptic curve cryptography (ECC),Elliptic curves,Protocols,Security,Vehicular ad hoc networks,vehicular ad hoc networks (VANETs)},
  file = {/home/sam/snap/zotero-snap/common/Zotero/storage/4GAJGY45/9580742.html}
}

@article{lodeComprehensiveReviewECCbased2026a,
  title = {A Comprehensive Review of {{ECC-based}} Certificateless Aggregate Signature for {{Vehicular Ad-Hoc Networks}} ({{VANETs}}) and Cryptanalysis of Quantum-Secure {{CLAS}}},
  author = {Lode, Vijaya and Pinapati, Anil},
  date = {2026-07-01},
  journaltitle = {Computers and Electrical Engineering},
  shortjournal = {Comput. Electr. Eng.},
  volume = {135},
  pages = {111174},
  issn = {0045-7906},
  doi = {10.1016/j.compeleceng.2026.111174},
  url = {https://www.sciencedirect.com/science/article/pii/S0045790626002466},
  urldate = {2026-07-16},
  abstract = {Vehicular Ad Hoc Networks (VANETs) are one of the essential and exciting types of ad hoc networks in the present intelligent transportation systems where the group of vehicles communicate to ensure vehicular safety and improve the standard of living for those who drive. While in communication, VANETs are vulnerable to privacy and security attacks. To provide authenticity in VANETs, signed messages are verified by road side units. If the number of messages increases, it will increase the time to verify every message. To minimize the computational overhead in VANETs and to verify each signature, it is enough to verify a single signature called aggregate signature. This paper provides a critical survey on different ways of computing pairing-free certificateless aggregate signature (CLAS) based on Elliptic Curve Cryptography(ECC). A CLAS scheme is a digital signature that combines multiple signatures from different messages coming from different vehicles into one single short signature to keep the signature verification process at a low cost and to reduce the signature size. This paper focuses on the thorough overview of ECC-based CLAS schemes, we also continue our work by performing a rigorous security analysis of a recent quantum-secure CLAS scheme and exposing a crucial weakness in it.},
  keywords = {Authentication,CLAS,ECC,Security & privacy,VANETs,Vulnerabilities},
  file = {/home/sam/snap/zotero-snap/common/Zotero/storage/YN989FJH/Lode and Pinapati - 2026 - A comprehensive review of ECC-based certificateless aggregate signature for Vehicular Ad-Hoc Network.pdf;/home/sam/snap/zotero-snap/common/Zotero/storage/QKNAX2HR/S0045790626002466.html}
}

@article{shimSecurityAggregateSignature2026,
  title = {On the Security of Aggregate Signature–Based Conditional Privacy-Preserving Authentication Schemes for {{VANETs}}},
  author = {Shim, Kyung-Ah and Kwon, Hyeokdong},
  date = {2026-06-01},
  journaltitle = {ICT Express},
  volume = {12},
  number = {3},
  pages = {566--570},
  issn = {2405-9595},
  doi = {10.1016/j.icte.2026.02.012},
  url = {https://www.sciencedirect.com/science/article/pii/S2405959526000330},
  urldate = {2026-07-17},
  abstract = {Certificateless aggregate signature (CLAS) schemes enable multiple vehicles to combine their individual signatures into a single compact authenticator, significantly reducing transmission and verification overhead in bandwidth-constrained vehicular ad-hoc networks (VANETs). This efficiency makes CLAS particularly attractive for real-time authentication in large-scale intelligent transportation systems (ITS). However, we show that two representative CLAS-based conditional privacy-preserving authentication schemes, proposed by Zhu–Guan and Chen–Guan, are vulnerable to a Type I adversary capable of replacing a vehicle’s public key. Such an adversary can forge valid signatures on arbitrary messages without obtaining the vehicle’s partial private key due to the lack of cryptographic binding between public keys and ephemeral randomness, which allows algebraic elimination of the master public key during verification. We analyze the root causes of this flaw and propose hash-based countermeasures that enforce strong binding among all public components. Our results further reveal that conventional linear hash-dependent CLAS constructions face inherent limitations in balancing security, ultra-low latency, and scalability. Thus, a next-generation CLAS design paradigm is required one that moves beyond traditional linear architectures to achieve deployment-level performance in current 5G-V2X environments while being inherently scalable toward future 6G-enabled intelligent transportation systems.},
  keywords = {Authentication protocol,Certificateless aggregate signature,Conditional privacy,Intelligent transportation systems,Public key replacement,Type I forgery,VANET},
  file = {/home/sam/snap/zotero-snap/common/Zotero/storage/RQEBN7WQ/Shim and Kwon - 2026 - On the security of aggregate signature–based conditional privacy-preserving authentication schemes f.pdf;/home/sam/snap/zotero-snap/common/Zotero/storage/M7A694KP/S2405959526000330.html}
}

